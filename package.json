{
  "name": "logistics-packing-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "AR1 internal tools webapp",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/styles.src.css -o ./assets/styles.css",
    "watch:css": "tailwindcss -i ./assets/styles.src.css -o ./assets/styles.css --watch",
    "build": "npm run build:css",
    "start": "npm run build:css && node local-server.js",
    "dev": "npm run start"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "tailwindcss": "^4.2.4"
  }
}
